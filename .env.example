# ==========================================
# Apple Music Playlist Scanner Configuration
# ==========================================

# 1. Your Apple Music Playlist URL
# In Apple Music app: click "..." next to playlist -> Share Playlist -> Copy Link
PLAYLIST_URL=https://music.apple.com/us/playlist/ctrl-alt-drop/pl.u-EXAMPLE

# 2. Telegram Bot Token
# Create a bot via @BotFather on Telegram (https://t.me/BotFather) and paste token here:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 3. Telegram Channel Username or Chat ID
# For public channel: @your_channel_name
# For private channel: -100xxxxxxxxxx (Run: python scanner.py --get-chat-id to find it)
TELEGRAM_CHAT_ID=@your_channel_or_id

# 4. Threshold of newly added songs before sending notification (default: 10)
THRESHOLD=10

# 5. Scanning interval in minutes when running in daemon mode (default: 30)
SCAN_INTERVAL_MINUTES=30
